# ── Virtual environment ──────────────────────────────────────────
.venv/

# ── Python artefacts ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# ── Jupyter ──────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Data ─────────────────────────────────────────────────────────
# Raw: ignore everything EXCEPT .gitkeep and the provenance manifest
data/raw/*
!data/raw/.gitkeep
!data/raw/MANIFEST.csv

# Interim and final are fully regenerable
data/interim/*
!data/interim/.gitkeep
data/final/*
!data/final/.gitkeep
data/v2/*
data/v2/**
!data/v2/.gitkeep
!data/v2/release/README.md
data/v2_1/*.parquet
data/v2_1/release/*.parquet
!data/v2_1/.gitkeep
!data/v2_1/release/README.md
!data/v2_1/folds.csv
!data/v2_1/release/folds.csv




# ── Outputs (regenerable) ───────────────────────────────────────
outputs/*
!outputs/.gitkeep
!outputs/*.csv
!outputs/*.txt
!outputs/*.py
!outputs/*.md
!outputs/v2/
!outputs/v2/**
!outputs/v2_1/
!outputs/v2_1/**




# ── IDE ──────────────────────────────────────────────────────────
.vscode/
.idea/

# ── OS ───────────────────────────────────────────────────────────
Thumbs.db
.DS_Store

# Office lock files (created while a document is open)
~$*

# Scratch directory
scratch/

